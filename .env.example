# Database (pilih salah satu dari Vercel Dashboard → Storage → PostgreSQL)
DATABASE_URL=postgres://user:password@host.vercel-storage.com/dbname?sslmode=require
# ATAU
POSTGRES_URL=postgres://user:password@host.vercel-storage.com/dbname?sslmode=require

# JWT Secret (generate: openssl rand -hex 32)
JWT_SECRET=ubah_ini_dengan_string_acak_minimal_32_karakter

# App URL (untuk production)
NEXT_PUBLIC_APP_URL=https://jadwalin.vercel.app

# Optional: Untuk development lokal dengan Neon/Supabase
# POSTGRES_URL_NON_POOLING=postgres://...